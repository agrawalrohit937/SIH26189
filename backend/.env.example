# ==============================================================================
# SIH26189 Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Neo4j Graph Database Connection (Neo4j Aura Cloud or Self-Hosted)
# Example Aura: neo4j+s://xxxxxxxx.databases.neo4j.io
# Example Local: bolt://localhost:7687
NEO4J_URI=neo4j+s://your-neo4j-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-secure-neo4j-password

# Groq Cloud API Key (for LLM Extraction & Copilot Chat)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Application Configuration
APP_NAME=Criminal Network Analysis System (SIH26189)
DEBUG=False
PORT=8000
HOST=0.0.0.0
