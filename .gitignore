# ==============================================================================
# SIH26189 - Root .gitignore (Full-Stack Monorepo)
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
!.env.example
!**/.env.example
*.env
*.pem
*.key
*.cert
*.secrets

# ------------------------------------------------------------------------------
# Python & Backend Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
backend/venv/
backend/env/
backend/ENV/
venv/
env/
ENV/
.venv/

# Pytest / Coverage / Profiling
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js & Next.js Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.vercel
frontend/.vercel

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# TypeScript
*.tsbuildinfo
next-env.d.ts.bak

# ESLint & Prettier
.eslintcache

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors & IDEs
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Temporary files & Artifacts
# ------------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
